# API (called by an external frontend; Supabase is the primary runtime store)
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000,https://your-existing-app.vercel.app
DEMO_MODE=false
RATE_LIMIT_MAX=120

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Intelligence worker
LLM_API_KEY=
LLM_API_BASE_URL=https://api.siliconflow.cn/v1
LLM_TEXT_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
LLM_VISION_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
LLM_AUDIO_MODEL=FunAudioLLM/SenseVoiceSmall
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL_MS=200
# Publish valid first-pass conversation directly unless evidence or safety checks require more work.
LLM_SIMPLE_REPLY_FAST_PATH=true
# Ground and verify memory/search evidence in one finalizer call instead of two serial calls.
LLM_SINGLE_PASS_EVIDENCE_FINALIZER=true

# Internal service authentication (server-only)
# Generate a different random value from WECHAT_CREDENTIAL_ENCRYPTION_KEY.
TOMEET_INTERNAL_API_TOKEN=
TOMEET_API_URL=http://localhost:4000

# WeChat transport: Tencent iLink onboarding + Railway worker (server-only)
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Set the exact same value on the API and wechat-ilink-worker services.
WECHAT_CREDENTIAL_ENCRYPTION_KEY=
# Personalized link appended to the first WeChat welcome. The page reads #claim.
WECHAT_WEB_REGISTRATION_URL=https://tomeet.chat/register
WECHAT_WEB_CLAIM_TTL_SECONDS=900
WECHAT_WORKER_CONCURRENCY=8
WECHAT_OUTBOUND_CONCURRENCY=20
WECHAT_WORKER_CLAIM_INTERVAL_MS=1000
# Delay between sentence-sized WeChat bubbles; use 0 in tests.
WECHAT_BUBBLE_DELAY_MS=200
WECHAT_TURN_BATCH_WINDOW_MS=400
# Only slow turns receive a working-status bubble; keep the default to one notice per turn.
WECHAT_TURN_PROGRESS_DELAY_MS=60000
WECHAT_TURN_PROGRESS_INTERVAL_MS=30000
WECHAT_TURN_PROGRESS_MAX_NOTICES=1
WECHAT_ILINK_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# AdventureX V1 clearing-tick matching. API and intelligence-worker must use the same value.
ADVENTUREX_MATCHING_V1=false
# Owner-only virtual matchmaking pool switch.
ADVENTUREX_TEST_POOL_ENABLED=false
ADVENTUREX_TEST_POOL_EMAIL=andy4fe0119@gmail.com

# Relationship credentials: Supabase RPCs + Injective EVM anchoring worker.
INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_EVM_CHAIN_ID=1439
INJECTIVE_EVM_EXPLORER_URL=https://testnet.blockscout.injective.network/
INJECTIVE_EVM_TESTNET_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_EVM_MAINNET_RPC_URL=
RELATIONSHIP_REGISTRY_ADDRESS=
# Server-only 0x-prefixed 32-byte key. Use a dedicated relayer, never a user wallet.
RELATIONSHIP_RELAYER_PRIVATE_KEY=
RELATIONSHIP_REGISTRY_DEPLOYMENT_BLOCK=0
RELATIONSHIP_WORKER_POLL_INTERVAL_MS=1000

# Optional for protocol testing; production should keep the official default.
# WECHAT_ILINK_QR_BASE_URL=https://ilinkai.weixin.qq.com
